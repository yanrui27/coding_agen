63. Use offset=291 to continue.)\n</content>","metadata":{"preview":"\n.op\n.control\nrun\nprint @vdd[i]\nprint @IREF[i]\nprint v(out)\nprint v(tail)\nprint v(d2)\n.print op all\n.endc\n.end\n\"\"\"\n    path = os.path.join(WORKDIR, 'dc_testbench.cir')\n    with open(path, 'w') as f:\n        f.write(tb)\n\n\ndef create_noise_testbench():\n    tb = \"\"\"* noise_testbench.cir - Closed-loop output-referred noise","truncated":true,"loaded":[],"display":{"type":"file","path":"/tmp/opencode/simulation.py","text":"\n.op\n.control\nrun\nprint @vdd[i]\nprint @IREF[i]\nprint v(out)\nprint v(tail)\nprint v(d2)\n.print op all\n.endc\n.end\n\"\"\"\n    path = os.path.join(WORKDIR, 'dc_testbench.cir')\n    with open(path, 'w') as f:\n        f.write(tb)\n\n\ndef create_noise_testbench():\n    tb = \"\"\"* noise_testbench.cir - Closed-loop output-referred noise\n.include \"\"\" + DATA_DIR + \"\"\"/mosfet_22nm.lib\n.include opamp_netlist.cir\n\nVDD  vdd  0  DC 1.2\nV0   vin  0  DC 0.6  AC 1\nV1   inp  0  DC 0.6\nXamp vdd  0  inp  inn  out  opamp\n\n* Capacitor feedback with large DC bias resistors\nC1   vin  inn  1.0p\nR0   vin  inn  10meg\nCFB  out  inn  1.0p\nR1   out  inn  10meg\nCL   out  0    0.94p\n\n.noise v(out) V0 dec 50 1.0Meg 500.0Meg\n.control\nrun\nset filetype=ascii\nsetplot noise1\nwrdata noise_data frequency onoise_spectrum\n.endc\n.end\n\"\"\"\n    path = os.path.join(WORKDIR, 'noise_testbench.cir')\n    with open(path, 'w') as f:\n        f.write(tb)\n\n\ndef create_swing_testbench():\n    tb = \"\"\"* swing_testbench.cir - offset-cancelled open-loop swing\n.include \"\"\" + DATA_DIR + \"\"\"/mosfet_22nm.lib\n.include opamp_netlist.cir\n\nVDD   vdd  0   DC 1.2\nVSWP  vip  0   DC 0.6\nXMAIN vdd  0   vip  vcancel  vout     opamp\nCL    vout 0   0.94p\nXHELP vdd  0   vip  vcancel  vcancel  opamp\n","lineStart":231,"lineEnd":290,"totalLines":963,"truncated":true}},"title":"tmp/opencode/simulation.py","time":{"start":1792323253773,"end":1792323253780}},"id":"prt_14ec