]}\")\n            return False\n        print(f\"  OK\")\n    return True\n\n\n##############################################################################\n# PARSING\n##############################################################################\n\ndef parse_ac():\n    rows = parse_wrdata(os.path.join(WORKDIR, 'ac_data'))\n    freqs, gains_db, phases = [], [], []\n    for r in rows:\n        if len(r) >= 7:\n            freqs.append(r[0])\n            gains_db.append(r[4])\n            phases.append(r[6])\n        elif len(r) >= 4:\n            freqs.append(r[0])\n            gains_db.append(r[2])\n            phases.append(r[3])\n        elif len(r) >= 3:\n            freqs.append(r[0])\n            gains_db.append(r[1])\n            phases.append(r[2])\n    \n    freqs = np.array(freqs)\n    gains_db = np.array(gains_db)\n    phases = np.array(phases)\n    \n    # Gain at 10 kHz\n    idx = np.argmin(np.abs(freqs - 1e4))\n    gain_10k_db = float(gains_db[idx])\n    if gain_10k_db > 200:\n        # Cap at 200 dB to avoid overflow, actual gain is extremely high\n        gain_10k_db = 200.0\n        gain_10k_vv = 1e10\n    else:","lineStart":305,"lineEnd":359,"totalLines":963,"truncated":true}},"title":"tmp/opencode/simulation.py","time":{"start":1792323249841,"end":1792323249850}},"id":"prt_14eca607a0013Vpb9SsFP4zuDU","sessionID":"ses_eb169bc13ffeEpLd78TBieNkiy","messageID":"msg_14eca18c4001WicSHBZ0QEKe2M"}}
