6\n139: M4  d2    d1    gnd   gnd   nmos  W=10u L=44n  AD=3.80e-7  AS=7.60e-7  PD=1.52e-7   PS=1.004e-6\n140: \n141: * --- STAGE 2: NMOS common-source + PMOS current source load ---\n142: M5  out   d2    gnd   gnd   nmos  W=80u L=44n  AD=3.04e-6  AS=6.08e-6  PD=1.216e-6  PS=4.004e-5\n143: \n144: * --- MILLER COMPENSATION ---\n145: Rz  d2    cc_mid  100\n146: Cc  cc_mid out     0.22p\n147: \n148: .ends opamp\n149: \"\"\"\n150:     path = os.path.join(WORKDIR, 'opamp_netlist.cir')\n151:     with open(path, 'w') as f:\n152:         f.write(netlist)\n153:     print(\"Op-amp netlist created.\")\n154: \n155: \n156: def create_ac_testbench():\n157:     tb = \"\"\"* ac_testbench.cir - Open-loop AC analysis\n158: .include \"\"\" + DATA_DIR + \"\"\"/mosfet_22nm.lib\n159: .include opamp_netlist.cir\n160: \n161: VDD  vdd  0  DC 1.2\n162: VCM  vcm  0  DC 0.6\n163: Xamp  vdd  0  vcm  inn  out  opamp\n164: \n165: * AC stimulus on inverting input\n166: VDC_inn  inn_dc  0  DC 0.6\n167: L_bias   inn_dc  inn  1T\n168: VAC_in   inn  inn_ac  AC 1\n169: C_ac     inn_ac  0  1T\n170: \n171: CL  out  0  0.94p  IC=0.7\n172: \n173: .ac dec 200 1 100G\n174: .control\n175: run\n176: let gain_db = vdb(out) - vdb(inn)\n\n(Showing lines 107-176 of 963. Use offset=177 to continue.)\n</content>","metadata":{"preview":"def create_opamp_netlist():\n    \"\"\"Create two-stage Miller-compensated CMOS op-amp netlist.\"\"\"\n    # All computed area/perimeter values for each device\n    netlist = \"\"\"* opamp_netlist.cir - Two-stage Miller-compensated CMOS op-amp\n* PTM 22nm HP CMOS Op-Amp\n* Bias: IREF=60uA, w6=20u, w7=200u (tail=600uA, branch=300uA), w8=100u (2nd=300uA)\n* Total I = 960uA, P = 1.15mW < 1.484mW\n* Input pair w12=5u L=44n, mirror w34=10u, gain stage w5=80u\n* Compensation: Rz=100ohm, Cc=0.22pF\n\n.include \"\"\" + DATA_DIR + \"\"\"\n\n.param lch=44n\n\n.subckt opamp vdd gnd inp inn out\n\n* --- PMOS BIAS MIRROR ---\n* IREF sinks 60uA from diode-connected M6 to GND\n* M6 (20u) sets gate voltage for M7 (200u) and M8 (100u)\nIREF   iref   gnd   DC 60u","truncated":true,"loaded":[],"display":{"type":"file","path":"/tmp/opencode/simulation.py","text":"def create_opamp_netlist():\n    \"\"\"Create two-stage Miller-compensated CMOS op-amp netlist.\"\"\"\n    # All computed area/perimeter values for each device\n    netlist = \"\"\"* opamp_netlist.cir - Two-stage Miller-compensated CMOS op-amp\n* PTM 22nm HP CMOS Op-Amp\n* Bias: IREF=60uA, w6=20u, w7=200u (tail=600uA, branch=300uA), w8=100u (2nd=300uA)\n* Total I = 960uA, P = 1.15mW < 1.484mW\n* Input pair w12=5u L=44n, mirror w34=10u, gain stage w5=80u\n* Compensation: Rz=100ohm, Cc=0.22pF\n\n.include \"\"\" + DATA_DIR + \"\"\"\n\n.param lch=44n\n\n.subckt opamp vdd gnd inp inn out\n\n* --- PMOS BIAS MIRROR ---\n* IREF sinks 60uA from diode-connected M6 to GND\n* M6 (20u) sets gate voltage for M7 (200u) and M8 (100u)\nIREF   iref   gnd   DC 60u\n\nM6  iref  iref  vdd  vdd   pmos  W=20u  L=44n  AD=7.60e-7  AS=1.52e-6  PD=3.04e-7  PS=2.304e-5\nM7  tail  iref  vdd  vdd   pmos  W=200u L=44n  AD=7.60e-6 AS=1.52e-5  PD=3.04e-6  PS=2.304e-4\nM8  out   iref  vdd  vdd   pmos  W=100u L=44n  AD=3.80e-6 AS=7.60e-6  PD=1.52e-6  PS=1.104e-4\n\n* --- STAGE 1: PMOS diff pair + NMOS active load ---\n* inn -> M1 gate, inp -> M2 gate, tail -> M7 source/drain\nM1  d1    inn   tail  vdd   pmos  W=5u  L=44n  AD=1.90e-7  AS=3.80e-7  PD=1.52e-7   PS=3.040e-6\nM2  d2    inp   tail  vdd   pmos  W=5u  L=44n  AD=1.90e-7  AS=3.80e-7  PD=1.52e-7   PS=3.040e-6\n\n* NMOS current mirror active load\nM3  d1    d1    gnd   gnd   nmos  W=10u L=44n  AD=3.80e-7  AS=7.60e-7  PD=1.52e-7   PS=1.004e-6\nM4  d2    d1    gnd   gnd   nmos  W=10u L=44n  AD=3.80e-7  AS=7.60e-7  PD=1.52e-7   PS=1.004e-6\n\n* --- STAGE 2: NMOS common-source + PMOS current source load ---\nM5  out   d2    gnd   gnd   nmos  W=80u L=44n  AD=3.04e-6  AS=6.08e-6  PD=1.216e-6  PS=4.004e-5\n\n* --- MILLER COMPENSATION ---\nRz  d2    cc_mid  100\nCc  cc_mid out     0.22p\n\n.ends opamp\n\"\"\"\n    path = os.path.join(WORKDIR, 'opamp_netlist.cir')\n    with open(path, 'w') as f:\n        f.write(netlist)\n    print(\"Op-amp netlist created.\")\n\n\ndef create_ac_testbench():\n    tb = \"\"\"* ac_testbench.cir - Open-loop AC analysis\n.include \"\"\" + DATA_DIR + \"\"\"/mosfet_22nm.lib\n.include opamp_netlist.cir\n\nVDD  vdd  0  DC 1.2\nVCM  vcm  0  DC 0.6\nXamp  vdd  0  vcm  inn  out  opamp\n\n* AC stimulus on inverting input\nVDC_inn  inn_dc  0  DC 0.6\nL_bias   inn_dc  inn  1T\nVAC_in   inn  inn_ac  AC 1\nC_ac     inn_ac  0  1T\n\nCL  out  0  0.94p  IC=0.7\n\n.ac dec 200 1 100G\n.control\nrun\nlet gain_db = vdb(out) - vdb(inn)","lineStart":107,"lineEnd":176,"totalLines":963,"truncated":true}},"title":"tmp/opencode/simulation.py","time":{"start":1792323321199,"end":1792323321206}},"id":"prt_14ecb78c5001uavgck1CpJaoEI","sessionID":"ses_eb169bc13ffeEpLd78TBieNkiy","messageID":"msg_14ecb73c3001BfLxEb1t6lo687"}}
