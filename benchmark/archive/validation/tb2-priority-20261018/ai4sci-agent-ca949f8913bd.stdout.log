 \"<stdin>\", line 24, in <module>\nAttributeError: module 'ctypes' has no attribute 'c_gid_t'. Did you mean: 'c_size_t'?\n","exit":1,"truncated":false},"title":"# We CAN change GID based on earlier ctypes test (setresgid succeeded)\n# Wait, it didn't succeed - it returned EPERM too.\n# Let me check if we can use setgroups at all\npython3 << 'PYEOF'\nimport os\nimport ctypes\nimport ctypes.util\n\nlibc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)\nsetresgid = libc.setresgid\nsetresgid.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int]\nsetresgid.restype = ctypes.c_int\n\nresult = setresgid(0, 0, 0)\nerrno = ctypes.get_errno()\nprint(f\"setresgid(0,0,0) returned: {result}, errno: {errno} ({os.strerror(errno) if errno else 'None'})\")\n\nsetresuid = libc.setresuid\nsetresuid.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int]\nsetresuid.restype = ctypes.c_int\n\nresult = setresuid(0, 0, 0)\nerrno = ctypes.get_errno()  \nprint(f\"setresuid(0,0,0) returned: {result}, errno: {errno} ({os.strerror(errno) if errno else 'None'})\")\n\n# Try setgroups\nsetgroups = libc.setgroups\nsetgroups.argtypes = [ctypes.c_size_t, ctypes.POINTER(ctypes.c_gid_t)]\nsetgroups.restype = ctypes.c_int\ngids = (ctypes.c_gid_t * 1)(0)  # root group\nresult = setgroups(1, gids)\nerrno = ctypes.get_errno()\nprint(f\"setgroups(1,[0]) returned: {result}, errno: {errno} ({os.strerror(errno) if errno else 'None'})\")\nPYEOF","time":{"start":1792323344436,"end":1792323344440}},"id":"prt_14ecba769001S6n3f3LRfLJQOU","sessionID":"ses_eb13bed45ffepZsEJZt8NUinzA","messageID":"msg_14ecba03f001C1sG80oWy8FQLa"}}
