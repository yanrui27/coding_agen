per_m = width * eps_0 * eps_r / (5e-4)\n    G_per_m = 1e-3 * C_per_m\n    \n    cal_lines.append({\n        'id': f'cal_{i+1:02d}',\n        'length_m': length,\n        'width_m': width,\n        'roughness_um': roughness * 1e6,\n        'R_dc_per_m': R_dc_per_m,\n        'L_per_m': L_per_m,\n        'G_per_m': G_per_m,\n        'C_per_m': C_per_m,\n    })\n\nwith open(f'{data_dir}/calibration_lines.csv', 'w', newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['target_id', 'length_m', 'width_m', 'roughness_um', \n                'R_dc_per_m', 'L_per_m', 'G_per_m', 'C_per_m'])\n    for line in cal_lines:\n        w.writerow([line['id'], f\"{line['length_m']:.6e}\", \n                   f\"{line['width_m']:.6e}\", f\"{line['roughness_um']:.4f}\",\n                   f\"{line['R_dc_per_m']:.6e}\", f\"{line['L_per_m']:.6e}\",\n                   f\"{line['G_per_m']:.6e}\", f\"{line['C_per_m']:.6e}\"])\n\n# --- Telegrapher's model ---\ndef get_skin_coeff(width_m, roughness_m):\n    k_skin = np.sqrt(np.pi * mu_0 / sigma_cond) / np.sqrt(width_m) * (1.0 + roughness_m / width_m * 2.0)\n    return k_skin\n\ndef compute_gamma(f_hz, R_dc_per_m, L_per_m, G_per_m, C_per_m, k_skin, length):\n    omega = 2 * np.pi * f_hz\n    Rs = (1 + 1j) * k_skin * np.sqrt(np.abs(f_hz))\n    Z = R_dc_per_m + Rs + 1j * omega * L_per_m\n    Y = G_per_m + 1j * omega * C_per_m\n    gamma = np.sqrt(Z * Y)\n    return Z, Y, gamma\n\n# --- Shared fixture ---\nfixture_tau = 2e-9\nfixture_cutoff = 5e9\nH_fixture = np.exp(-1j * omega * fixture_tau) / (1 + 1j * omega / (2 * np.pi * fixture_cutoff))\n\n# --- Per-line systematic errors ---\ngains_cal = 0.98 + np.random.rand(8) * 0.04\ndelays_cal = np.random.uniform(-0.3e-9, 0.3e-9, 8)\nnoise_level = 0.01\n\n# --- Generate measured H_transfer ---\nmeasured_h = np.zeros((len(cal_lines), n_freq), dtype=complex)\n\nfor idx, line in enumerate(cal_lines):\n    k_skin = get_skin_coeff(line['width_m'], line['roughness_um'] * 1e-6)\n    _, _, gamma = compute_gamma(\n        freqs, line['R_dc_per_m'], line['L_per_m'], \n        line['G_per_m'], line['C_per_m'], k_skin, length=1.0\n    )\n    H_intrinsic = np.exp(-gamma * line['length_m'])\n    H_measured = H_fixture * gains_cal[idx] * np.exp(-1j * omega * delays_cal[idx]) * H_intrinsic\n    H_measured += noise_level * (np.random.randn(n_freq) + 1j * np.random.randn(n_freq)) * np.abs(H_measured)\n    measured_h[idx] = H_measured\n\nwith open(f'{data_dir}/calibration_transfer.csv', 'w', newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['cal_id', 'frequency_hz', 'real_H', 'imag_H'])\n    for idx, line in enumerate(cal_lines):\n        for fi in range(n_freq):\n            w.writerow([line['id'], f'{freqs[fi]:.6e}',\n                       f'{measured_h[idx, fi].real:.8e}',\n                       f'{measured_h[idx, fi].imag:.8e}'])\n\n# --- Target lines ---\ntarget_lines = []\nfor i in range(4):\n    length = 0.075 + i * 0.05\n    width = 0.7e-3 if i < 2 else 0.35e-3\n    roughness = 12e-6 + i * 6e-6\n    \n    thickness = 35e-6\n    R_dc_per_m = 1.0 / (sigma_cond * width * thickness)\n    L_per_m = 1e-9 * (eps_r + 1) / 2 / width * 5e-4\n    C_per_m = width * eps_0 * eps_r / (5e-4)\n    G_per_m = 1e-3 * C_per_m\n    \n    target_lines.append({\n        'id': f'tgt_{i+1:02d}',\n        'length_m': length,\n        'width_m': width,\n        'roughness_um': roughness * 1e6,\n        'R_dc_per_m': R_dc_per_m,\n        'L_per_m': L_per_m,\n        'G_per_m': G_per_m,\n        'C_per_m': C_per_m,\n    })\n\nwith open(f'{data_dir}/target_lines.csv', 'w', newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['target_id', 'length_m', 'width_m', 'roughness_um',\n                'R_dc_per_m', 'L_per_m', 'G_per_m', 'C_per_m'])\n    for line in target_lines:\n        w.writerow([line['id'], f\"{line['length_m']:.6e}\",\n                   f\"{line['width_m']:.6e}\", f\"{line['roughness_um']:.4f}\",\n                   f\"{line['R_dc_per_m']:.6e}\", f\"{line['L_per_m']:.6e}\",\n                   f\"{line['G_per_m']:.6e}\", f\"{line['C_per_m']:.6e}\"])\n\nprint(\"Data generation complete!\")\nprint(f\"Directory: {data_dir}\")\nprint(f\"Files: {os.listdir(data_dir)}\")\nGENEOF","timeout":30000},"output":"Data generation complete!\nDirectory: /tmp/data_work\nFiles: ['frequency_grid.csv', 'input_pulse.csv', 'calibration_lines.csv', 'calibration_transfer.csv', 'target_lines.csv']\n","metadata":{"output":"Data generation complete!\nDirectory: /tmp/data_work\nFiles: ['frequency_grid.csv', 'input_pulse.csv', 'calibration_lines.csv', 'calibration_transfer.csv', 'target_lines.csv']\n","exit":0,"truncated":false},"title":"python3 << 'GENEOF'\nimport numpy as np\nimport csv\nimport os\n\n# Create data dir in /tmp since workspace/data is not writable\ndata_dir = '/tmp/data_work'\nos.makedirs(data_dir, exist_ok=True)\nos.makedirs('/tmp/results_work', exist_ok=True)\n\nnp.random.seed(42)\n\n# --- Frequency grid: 1 MHz to 20 GHz, logspace with ~1000 points ---\nf_min = 1e6   # 1 MHz\nf_max = 20e9  # 20 GHz\nn_freq = 1001\nfreqs = np.logspace(np.log10(f_min), np.log10(f_max), n_freq)\nomega = 2 * np.pi * freqs\n\n# Write frequency_grid.csv\nwith open(f'{data_dir}/frequency_grid.csv', 'w', newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['index', 'frequency_hz'])\n    for i, freq in enumerate(freqs):\n        w.writerow([i, f'{freq:.6e}'])\n\n# --- Input pulse: a Gaussian-like pulse ---\nn_samples = 2048\ndt = 1e-3 / (f_max * 4)\ntotal_time = n_samples * dt\ntimes = np.arange(n_samples) * dt - total_time / 2\npulse_center = 50e-9\npulse_width = 20e-9\ninput_pulse = np.exp(-0.5 * ((times - pulse_center) / pulse_width)**2)\ninput_pulse = input_pulse - np.mean(input_pulse)\n\nwith open(f'{data_dir}/input_pulse.csv', 'w', newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['index', 'time_s', 'voltage_v'])\n    for i, (t, v) in enumerate(zip(times, input_pulse)):\n        w.writerow([i, f'{t:.6e}', f'{v:.6f}'])\n\n# --- Physical parameters ---