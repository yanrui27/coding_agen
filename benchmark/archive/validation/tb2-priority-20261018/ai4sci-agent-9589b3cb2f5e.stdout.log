n    elif tc > 2: sn, ra = 0.0, 1.0\n    else: sn, ra = 1.0-(tc+2)/4, (tc+2)/4\n    sp.precip_add(sn * p_mm, ra * p_mm)\n    m = sp.step(3600, T_K, float(row['RH']), float(row['wind']),\n                float(row['SW']), float(row['LW']), float(row['P']))\n    total_liq = sum(l.liq_mm for l in sp.L)\n    max_liq = max(l.liq_mm for l in sp.L)\n    swe = sp.swe\n    run = sp._d_run\n    print(f'  {ti}: T={T_K:.1f}K sw={float(row[\\\"SW\\\"]):.0f} melt_step={m:.2f} swe={swe:.1f} liq={total_liq:.1f} run={run:.2f}')\n\n# Now full day\nsp2 = Snowpack(load_init('snowpack_init.json'))\nsp2._reset_day()\nfor ti in grp.index:\n    dta_idx = list(forc.index).index(ti)\n    row = forc.iloc[dta_idx]\n    T_K = float(row['T_K'])\n    p_mm = float(row['precip_mm'])\n    tc = T_K - 273.15\n    if tc < -2: sn, ra = 1.0, 0.0\n    elif tc > 2: sn, ra = 0.0, 1.0\n    else: sn, ra = 1.0-(tc+2)/4, (tc+2)/4\n    sp2.precip_add(sn * p_mm, ra * p_mm)\n    sp2.step(3600, T_K, float(row['RH']), float(row['wind']),\n             float(row['SW']), float(row['LW']), float(row['P']))\n\nswe1 = sp2.swe\nprecip_in = sum(float(row['precip_mm']) for _, row in grp.iterrows())\nprint(f'\\\\nDay summary: swe0={swe0:.1f} swe1={swe1:.1f} p_in={precip_in:.1f}')\nprint(f'  e_melt={sp2._d_melt:.1f} runoff={sp2._d_run:.1f}')\nprint(f'  max L0 liq={sp2.L[0].liq_mm:.1f} max L0 vol_frac={sp2.L[0].liq_vol_frac():.3f}')\n\"","time":{"start":1792323174098,"end":1792323174193}},"id":"prt_14ec8aaaf001ElyEu6gaFp3fdI","sessionID":"ses_eb16a0724ffedtrJL7v99LYylh","messageID":"msg_14ec87b56001eppK2OyQAxGL9b"}}
