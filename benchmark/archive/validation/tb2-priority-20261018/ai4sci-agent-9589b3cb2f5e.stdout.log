p_mm, ((tc+2)/4)*p_mm\n        \n        sp.precip_add(sn_mm, ra_mm)\n        sp.step(3600, T_K, float(row['RH']), float(row['wind']),\n                float(row['SW']), float(row['LW']), float(row['P']))\n    \n    # Check for anomalies\n    for i, l in enumerate(sp.L):\n        if l.T < 200 or l.T > 1000 or l.h > 10 or l.rho > 1000:\n            print(f'ANOMALY on {day}: L{i}: T={l.T:.2f}K h={l.h:.4f}m rho={l.rho:.0f}')\n\nprint('Done')\n\"","time":{"start":1792323308143,"end":1792323308239}},"id":"prt_14ecb10a6001XGZqTpDp55cQd0","sessionID":"ses_eb16a0724ffedtrJL7v99LYylh","messageID":"msg_14ecad7c80018JYvdPwIPmKU2V"}}
