n        p_mm = float(row['precip_mm'])\n        tc = T_K - T0\n        if tc < -2:     sn_mm, ra_mm = 1.0 * p_mm, 0.0\n        elif tc > 2:    sn_mm, ra_mm = 0.0, 1.0 * p_mm\n        else:           sn_mm, ra_mm = (1.0-(tc+2)/4)*p_mm, ((tc+2)/4)*p_mm\n        \n        sp.precip_add(sn_mm, ra_mm)\n        sp.step(3600, T_K, float(row['RH']), float(row['wind']),\n                float(row['SW']), float(row['LW']), float(row['P']))\n        sn_total += sn_mm\n        ra_total += ra_mm\n    \n    swe1 = sp.swe\n    total_liq_day = sum(l.liq_mm for l in sp.L)\n    total_ice_day = sum(l.ice_mm for l in sp.L)\n    run_day = sp._d_run\n    print(f'{str(day)[:10]}: swe {swe0:.1f}->{swe1:.1f} p={sn_total:.1f}+{ra_total:.1f} e_m={sp._d_melt:.1f} r={run_day:.1f} liq_snow={total_liq_day:.1f} ice_snow={total_ice_day:.1f}')\n\nprint(f'\\\\nFinal: SWE={sp.swe:.1f} ice={sum(l.ice_mm for l in sp.L):.1f} liq={sum(l.liq_mm for l in sp.L):.1f}')\nprint(f'Final T: {[l.T for l in sp.L]} K')\n\"","time":{"start":1792323278684,"end":1792323278771}},"id":"prt_14eca87a5001CS3AAVb1GHU198","sessionID":"ses_eb16a0724ffedtrJL7v99LYylh","messageID":"msg_14eca73ac001hgLht7RybeGxQM"}}
