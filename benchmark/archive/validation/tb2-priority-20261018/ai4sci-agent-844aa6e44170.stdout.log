0.8\n+ JS=1.0E-8\n+ RS=50\n+ RD=50\n+ IS=1.0E-14\n+ MJSW=0.5\n+ MJSWD=0.0)\n\n.model nmos_os NMOS (\n+ LEVEL=1\n+ VTO=0.30\n+ KP=260E-6\n+ LAMBDA=0.06\n+ PHI=0.7\n+ CGSO=0.20E-12\n+ CGDO=0.20E-12\n+ CGBO=0.0\n+ CJ=0.0\n+ CJSW=1.2E-12\n+ CJSWG=0.0\n+ PB=0.8\n+ JS=1.0E-8\n+ RS=40\n+ RD=40\n+ IS=1.0E-14\n+ MJSW=0.5\n+ MJSWD=0.0)\n\n.model pmos_n40 PMOS (\n+ LEVEL=1\n+ VTO=-0.38\n+ KP=85E-6\n+ LAMBDA=0.08\n+ PHI=0.7\n+ CGSO=0.15E-12\n+ CGDO=0.15E-12\n+ CGBO=0.0\n+ CJ=0.0\n+ CJSW=1.0E-12\n+ CJSWG=0.0\n+ PB=0.8\n+ JS=1.0E-8\n+ RS=50\n+ RD=50\n+ IS=1.0E-14\n+ MJSW=0.5\n+ MJSWD=0.0)\n\n.model pmos_os PMOS (\n+ LEVEL=1\n+ VTO=-0.32\n+ KP=95E-6\n+ LAMBDA=0.06\n+ PHI=0.7\n+ CGSO=0.20E-12\n+ CGDO=0.20E-12\n+ CGBO=0.0\n+ CJ=0.0\n+ CJSW=1.2E-12\n+ CJSWG=0.0\n+ PB=0.8\n+ JS=1.0E-8\n+ RS=40\n+ RD=40\n+ IS=1.0E-14\n+ MJSW=0.5\n+ MJSWD=0.0)\nMOSLIB_EOF\necho \"model library created\"\n","time":{"start":1792321176175,"end":1792321176179}},"id":"prt_14eaa5d04001iaymcPAnV65cOE","sessionID":"ses_eb15e7b1cffeLnOk9sPO4LaxxU","messageID":"msg_14eaa3c0e001yWOfL1IrH1mFY5"}}
