  "title": "[Bugfix] Await the accepted-token copy before moving batch rows",
  "user": {
    "login": "johny-jose",
    "id": 16204023,
    "node_id": "MDQ6VXNlcjE2MjA0MDIz",
    "avatar_url": "https://avatars.githubusercontent.com/u/16204023?v=4",
    "gravatar_id": "",
