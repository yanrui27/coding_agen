  "title": "[Bugfix] MambaManager.find_longest_cache_hit ignores drop_eagle_block, silent corruption with prefix caching + MTP/EAGLE",
  "user": {
    "login": "limwand",
    "id": 7585356,
    "node_id": "MDQ6VXNlcjc1ODUzNTY=",
    "avatar_url": "https://avatars.githubusercontent.com/u/7585356?v=4",
    "gravatar_id": "",
